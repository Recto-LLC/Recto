<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- MAUI Blazor host (Recto/Recto) -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.51" />
    <PackageVersion Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.51" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.51" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.5" />
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.4.0" />
    <PackageVersion Include="Xamarin.AndroidX.Biometric" Version="1.1.0.32" />
    <PackageVersion Include="Xamarin.Firebase.Messaging" Version="125.0.1.2" />

    <!-- NU1608 sweep (2026-09-21): Biometric / Firebase.Messaging drag the
         AndroidX *.Ktx packages in at 2.9.x / 1.8.8 / 1.10.1 / 1.3.1, whose
         upper bounds exclude the cores MAUI 10.0.51 resolves (Lifecycle
         2.10.0.2, Fragment 1.8.9.2, Activity 1.12.4.1, SavedState 1.4.0.2).
         Pinning each Ktx to its core's version makes the graph consistent;
         the versions below are the core versions, verified on NuGet. Raise
         them together when Microsoft.Maui.Controls moves. -->
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.10.0.2" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.10.0.2" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.10.0.2" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx.Android" Version="2.10.0.2" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="2.10.0.2" />
    <PackageVersion Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.8.9.2" />
    <PackageVersion Include="Xamarin.AndroidX.Activity.Ktx" Version="1.12.4.1" />
    <PackageVersion Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" Version="1.4.0.2" />

    <!-- DataStore's native library (libdatastore_shared_counter.so) must be aligned for 16 KB pages
         (Google Play's requirement for 64-bit libraries) AND built by a current NDK: Play's 16 KB notice
         named the library of 1.2.0.2 and of 1.2.1.1, which are aligned but were built with NDK r20.
         1.3.0 is the first binding whose library was rebuilt (NDK r27, API 24, read from the package's
         .note.android.ident). Firebase Messaging's own graph still resolves an older one, so the direct
         reference in Recto.csproj holds this version, and the build's Play gates read both the alignment
         and the NDK from the package. Raise it, never lower it, and let the gates judge the new one. -->
    <PackageVersion Include="Xamarin.AndroidX.DataStore.Core.Android" Version="1.3.0" />
    <!-- The rest of the DataStore family, held at the same version: each sibling bounds the others
         to its own patch line, so one raised alone is NU1608. And the AndroidX Collection family,
         because DataStore 1.3.0 needs Collection 1.7.0 while this MAUI's graph asks for 1.5.0.5 and
         bounds it below 1.5.1 (NU1107 without these three). Raise each family together. -->
    <PackageVersion Include="Xamarin.AndroidX.DataStore" Version="1.3.0" />
    <PackageVersion Include="Xamarin.AndroidX.DataStore.Android" Version="1.3.0" />
    <PackageVersion Include="Xamarin.AndroidX.DataStore.Core" Version="1.3.0" />
    <PackageVersion Include="Xamarin.AndroidX.DataStore.Core.Jvm" Version="1.3.0" />
    <PackageVersion Include="Xamarin.AndroidX.DataStore.Core.OkIO" Version="1.3.0" />
    <PackageVersion Include="Xamarin.AndroidX.DataStore.Core.OkIO.Jvm" Version="1.3.0" />
    <PackageVersion Include="Xamarin.AndroidX.DataStore.Preferences" Version="1.3.0" />
    <PackageVersion Include="Xamarin.AndroidX.DataStore.Preferences.Android" Version="1.3.0" />
    <PackageVersion Include="Xamarin.AndroidX.DataStore.Preferences.Core" Version="1.3.0" />
    <PackageVersion Include="Xamarin.AndroidX.DataStore.Preferences.Core.Android" Version="1.3.0" />
    <PackageVersion Include="Xamarin.AndroidX.DataStore.Preferences.External.Protobuf" Version="1.3.0" />
    <PackageVersion Include="Xamarin.AndroidX.DataStore.Preferences.Proto" Version="1.3.0" />
    <PackageVersion Include="Xamarin.AndroidX.Collection" Version="1.7.0" />
    <PackageVersion Include="Xamarin.AndroidX.Collection.Jvm" Version="1.7.0" />
    <PackageVersion Include="Xamarin.AndroidX.Collection.Ktx" Version="1.7.0" />

    <!-- ZXing.Net.Maui RETIRED Build 5 (2026-06-02). Both packages
         crashed on iOS first-permission-grant AND Android 16
         16KB-page-alignment. Replaced by native bindings (iOS uses
         AVFoundation directly; Android uses CameraX 1.5+ + ML Kit).
         See Recto.csproj comment block for the architectural rationale. -->
    <!-- <PackageVersion Include="ZXing.Net.Maui" Version="0.4.0" /> -->
    <!-- <PackageVersion Include="ZXing.Net.Maui.Controls" Version="0.4.0" /> -->

    <!-- Build 5 (2026-06-02): native Android QR scanner stack.
         CameraX 1.5+ ships 16KB-page-aligned native libs that pass
         Android 16's alignment check (the load-bearing reason for
         dropping ZXing.Net.Maui). ML Kit barcode scanner is Google's
         first-party QR decode implementation. All four package
         versions track the most-recent stable Xamarin bindings at
         the Build 5 ship time; if a future bump introduces a
         regression, pin to specific older versions here. -->
    <PackageVersion Include="Xamarin.AndroidX.Camera.Camera2" Version="1.5.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.5.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Camera.View" Version="1.5.0.1" />
    <PackageVersion Include="Xamarin.Google.MLKit.BarcodeScanning" Version="117.3.0.7" />

    <!-- Shared library (Recto/Recto.Shared) -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="10.0.5" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="Polly" Version="8.6.6" />
    <PackageVersion Include="Scrutor" Version="7.0.0" />
    <PackageVersion Include="Serilog" Version="4.3.1" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.17.0" />

    <!-- Phase 2.B: QR encoder. Pure-managed MIT-licensed; PngByteQRCode
         + SvgQRCode classes for cross-platform PNG/SVG without
         System.Drawing dependency. Sister of Python's qrcode library
         (Phase 1 substrate); both produce QR codes from the same
         canonical-JSON input bytes. -->
    <PackageVersion Include="QRCoder" Version="1.6.0" />

    <!-- Test project (Recto/Recto.Shared.Tests) -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
  </ItemGroup>
</Project>
